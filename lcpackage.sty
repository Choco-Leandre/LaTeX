\newcommand{\pg}[1]{%
    \tikz[baseline=(X.base)] 
    \node[fill=verygray, rounded corners=3pt, text=myText, font=\ttfamily, inner xsep=2pt, inner ysep=2pt] (X) {#1};%
}
