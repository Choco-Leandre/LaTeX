% --- Structures de démonstration (xBox, Donc, Mq, But) ---
\newcommand{\xBox}[3]{
\begin{thmbox}[M]{\textbf{#1}}
\noindent #2\vspace*{5pt}
\end{thmbox}\vspace*{-10pt}
\hspace*{40pt} #3
}

\newcommand{\XBox}[3]{
    \begin{thmbox}[S]{\textbf{#1}}
        #2%
    \end{thmbox}\vspace*{-15pt}
    \hspace*{40pt} #3
}

\newcommand{\Mq}[1]{\textbf{\textcolor{myBlue}{#1}}}
\newcommand{\Question}[2]{\noindent\textbf{- #1\hfill \emph{\textcolor{mygrayblue}{(#2)}}}}
\newcommand{\Donc}[0]{\underline{Donc:}\quad}
\newcommand{\But}[1]{\textbf{\textcolor{mypurple}{#1}}}
\newcommand{\Torseur}[1]{\begin{Bmatrix}#1\end{Bmatrix}}

% --- Codes (Python & SQL) ---
\newtcblisting{prog}[2][]{%
  width=\ifdim\linewidth<\textwidth \linewidth \else 0.85\linewidth \fi,
  center, 
  colframe=pyFrameColor, 
  colback=boxbg, 
  coltitle=white, 
  boxrule=1.5pt, 
  rounded corners,
  arc=5pt,
  fonttitle=\sffamily\bfseries,
  halign title=center,
  title={#2},
  left=5pt,
  top=2pt,
  bottom=2pt,
  #1,
  listing only,
  listing options={%
    language=Python,
    inputencoding=utf8,
    literate=
  {é}{{\'e}}1 {É}{{\'E}}1 {è}{{\`e}}1 {ê}{{\^e}}1 {à}{{\`a}}1 {â}{{\^a}}1 {ç}{{\c{c}}}1 {ù}{{\`u}}1 {î}{{\^i}}1 {ô}{{\^o}}1,
    extendedchars=true,
    basicstyle=\color{myText}\fontsize{9pt}{11pt}\ttfamily,
    keywordstyle=\color{myKeyword}\bfseries,
    morekeywords={import, from, as, def, return, class, pass, if, elif, else, while, for, in, and, or, not, True, False, None},
    emph={numpy, np, matplotlib, plt, scipy, array, linspace, plot, show, figure, polyfit, print, append, len, range},
    emphstyle=\color{myFunction}\bfseries,
    commentstyle=\color{myComment}\itshape, 
    stringstyle=\color{myString},
    identifierstyle=\color{myText},
    showstringspaces=false,
    numbers=left,
    numberstyle=\tiny\color{myLineNumbers},
    numbersep=12pt,
    xleftmargin=15pt,
  },
}

\newtcblisting{progSQL}[2][]{%
  width=\ifdim\linewidth<\textwidth \linewidth \else 0.85\linewidth \fi,
  center, 
  colframe=boxheader, 
  colback=boxbg, 
  coltitle=white, 
  boxrule=1.5pt, 
  rounded corners,
  arc=5pt,
  fonttitle=\sffamily\bfseries,
  halign title=center,
  title={#2},
  left=5pt,
  top=2pt,
  bottom=2pt,
  #1,
  listing only,
  listing options={%
    language=SQL,
    inputencoding=utf8,
    literate=
  {é}{{\'e}}1 {É}{{\'E}}1 {è}{{\`e}}1 {ê}{{\^e}}1 {à}{{\`a}}1 {â}{{\^a}}1 {ç}{{\c{c}}}1 {ù}{{\`u}}1 {î}{{\^i}}1 {ô}{{\^o}}1,
    extendedchars=true,
    basicstyle=\color{white}\fontsize{9pt}{11pt}\ttfamily,
    keywordstyle=\color{sqlKeyword}\bfseries,
    morekeywords={REFERENCES, TEXT, INT, PRIMARY, KEY, AUTO_INCREMENT, VARCHAR, BOOLEAN},
    emph={COUNT, SUM, AVG, MAX, MIN},
    emphstyle=\color{sqlKeyword}\bfseries,
    commentstyle=\color{sqlComment}\itshape, 
    stringstyle=\color{sqlString},
    identifierstyle=\color{white},
    showstringspaces=false,
    numbers=left,
    numberstyle=\tiny\color{myLineNumbers},
    numbersep=12pt,
    xleftmargin=15pt,
  },
}

